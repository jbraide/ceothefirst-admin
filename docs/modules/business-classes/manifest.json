    "bookings": {
      "name": "Booking Management",
      "description": "Date-based reservations — overlap detection, date validation, cancellation",
      "businessTypes": ["both"],
      "features": ["bookings"],
      "endpoints": [
        {
          "method": "POST",
          "path": "/bookings",
          "feature": "bookings",
          "description": "Create booking (overlap + date validation enforced)"
        },
        {
          "method": "GET",
          "path": "/bookings",
          "feature": "bookings",
          "description": "List bookings (filter by status, propertyId, date range)"
        },
        {
          "method": "GET",
          "path": "/bookings/:id",
          "feature": "bookings",
          "description": "Get booking with property + guest"
        },
        {
          "method": "PATCH",
          "path": "/bookings/:id",
          "feature": "bookings",
          "description": "Update booking (date validation, supports paymentMethod — creates transaction on payment)"
        },
        {
          "method": "POST",
          "path": "/bookings/:id/cancel",
          "feature": "bookings",
          "description": "Cancel booking — restores property to available if no remaining bookings"
        },
        {
          "method": "DELETE",
          "path": "/bookings/:id",
          "feature": "bookings",
          "description": "Delete booking (cleans up associated reviews first)"
        }
      ],
      "edgeCases": [
        "Overlap detection: blocks bookings that overlap existing non-cancelled bookings on the same property",
        "Date validation: checkOut must be after checkIn",
        "Maintenance block: cannot book a property with status 'maintenance'",
        "Auto-occupied: property status set to 'occupied' on booking creation",
        "Cancel restore: property set back to 'available' if no remaining bookings"
      ]
    },
