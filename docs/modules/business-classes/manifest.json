          "description": "Cash book — full transaction log (paginated, filterable)"
        },
        {
          "method": "GET",
          "path": "/reports/summary",
          "feature": "advanced_reports",
          "description": "Period summary — money in/out for date range"
        },
        {
          "method": "GET",
          "path": "/reports/all-time",
          "feature": "advanced_reports",
          "description": "All-time totals — lifetime sales, purchases, repayments"
        }
      ],
      "notes": "Only business owner can access reports. Staff members are blocked."
    },
    "staff": {
      "name": "Staff Management",
      "description": "Add employees with limited access — no financial reports, no cost prices",
