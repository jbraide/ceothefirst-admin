        {
          "method": "GET",
          "path": "/debts/summary",
          "feature": "debts",
          "description": "Debt summary — total receivable/payable/net"
        },
        {
          "method": "GET",
          "path": "/debts/:id",
          "feature": "debts",
          "description": "Get single debt record"
        },
        {
          "method": "POST",
          "path": "/debts/:id/pay",
          "feature": "debts",
          "description": "Record repayment — updates status, creates transaction"
        }
      ]
    },
    "invoices": {
      "name": "Invoices",
      "description": "Formal numbered invoices with payments, PDF export, and recurring support",
      "businessTypes": ["product", "service", "both"],
      "features": ["invoices"],
      "endpoints": [
        {
          "method": "POST",
          "path": "/invoices",
          "feature": "invoices",
          "description": "Create invoice (supports projectId, isRecurring)"
        },
        {
          "method": "POST",
          "path": "/invoices/recurring",
          "feature": "recurring_invoices",
          "description": "Create recurring invoice"
        },
        {
          "method": "POST",
          "path": "/invoices/recurring/generate",
          "feature": "recurring_invoices",
          "description": "Generate due recurring invoices (admin/cron)"
        },
        {
          "method": "GET",
          "path": "/invoices",
          "feature": "invoices",
          "description": "List invoices (filter by status, contactId)"
        },
        {
          "method": "GET",
          "path": "/invoices/:id",
          "feature": "invoices",
          "description": "Get invoice with line items"
        },
        {
          "method": "POST",
          "path": "/invoices/:id/pay",
          "feature": "invoices",
          "description": "Record payment — updates status, creates transaction"
        },
        {
          "method": "GET",
          "path": "/invoices/:id/pdf",
          "feature": "invoices",
          "description": "Download invoice PDF"
        },
        {
          "method": "DELETE",
          "path": "/invoices/:id",
          "feature": "invoices",
          "description": "Cancel invoice (only if unpaid)"
        },
        {
          "method": "PATCH",
          "path": "/invoices/:id",
          "feature": "invoices",
          "description": "Update invoice (only if not paid/void)"
        }
      ]
    },
    "reports": {
      "name": "Reports",
      "description": "Dashboard, cash book, period summaries, daily summary, all-time aggregates",
      "businessTypes": ["product", "service", "both"],
      "features": ["basic_reports"],
      "endpoints": [
        {
          "method": "GET",
