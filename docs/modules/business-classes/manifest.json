    "projects": {
      "name": "Project Management",
      "description": "Client projects with milestones, payment tracking, deadlines",
      "businessTypes": ["service", "both"],
      "features": ["projects"],
      "endpoints": [
        {
          "method": "POST",
          "path": "/projects",
