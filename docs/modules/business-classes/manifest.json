        {
          "method": "PATCH",
          "path": "/leads/:id",
          "feature": "leads",
          "description": "Update lead (status, followUpDate, convert to contact)"
        },
        {
          "method": "DELETE",
          "path": "/leads/:id",
          "feature": "leads",
          "description": "Delete lead"
