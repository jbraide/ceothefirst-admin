  "modules": {
    "auth": {
      "name": "Authentication",
      "description": "Sign up, login, PIN reset, token management",
      "businessTypes": ["product", "service", "both"],
      "features": ["auth"],
      "endpoints": [
        {
          "method": "POST",
          "path": "/auth/register",
          "feature": "auth",
          "description": "Register a new business"
        },
        {
          "method": "POST",
          "path": "/auth/login",
          "feature": "auth",
          "description": "Login with phone + PIN"
        },
        {
          "method": "POST",
          "path": "/auth/token/refresh",
          "feature": "auth",
          "description": "Refresh access token"
        },
        {
          "method": "POST",
          "path": "/auth/pin/reset-request",
          "feature": "auth",
          "description": "Request PIN reset OTP"
        },
        {
          "method": "POST",
          "path": "/auth/pin/reset-confirm",
          "feature": "auth",
          "description": "Confirm PIN reset"
        },
        {
          "method": "POST",
          "path": "/auth/staff/login",
          "feature": "auth",
          "description": "Staff member login"
        }
      ]
    },
    "business": {
      "name": "Business Profile",
      "description": "Business details, bank info, daily reminders, plan management",
      "businessTypes": ["product", "service", "both"],
      "features": ["business_profile"],
      "endpoints": [
        {
          "method": "GET",
          "path": "/business/profile",
          "feature": "business_profile",
          "description": "Get business profile with plan details (name, label, price, limits)"
        },
        {
          "method": "PATCH",
          "path": "/business/profile",
          "feature": "business_profile",
          "description": "Update profile — ownerName, address, category, state, city, bankName, accountNumber, reminderTime"
        },
        {
          "method": "PATCH",
          "path": "/business/reminder-time",
          "feature": "business_profile",
          "description": "Set daily bookkeeping reminder"
        },
        {
          "method": "POST",
          "path": "/business/bank/validate",
          "feature": "business_profile",
          "description": "Validate NUBAN account"
        }
      ]
    },
    "contacts": {
      "name": "Contacts",
      "description": "Customers, suppliers, clients, guests — with source and status tracking",
      "businessTypes": ["product", "service", "both"],
      "features": ["contacts"],
      "endpoints": [
        {
          "method": "POST",
          "path": "/contacts",
          "feature": "contacts",
          "description": "Create contact (supports source, contactStatus)"
        },
        {
          "method": "GET",
          "path": "/contacts?type=CUSTOMER",
          "feature": "contacts",
          "description": "List contacts by type"
        },
        {
          "method": "GET",
          "path": "/contacts/:id",
          "feature": "contacts",
          "description": "Get contact with balance + history"
        },
        {
          "method": "GET",
          "path": "/contacts/:id/transactions",
          "feature": "contacts",
          "description": "Contact transaction history"
        },
        {
          "method": "PATCH",
          "path": "/contacts/:id",
          "feature": "contacts",
          "description": "Update contact"
        },
        {
          "method": "DELETE",
          "path": "/contacts/:id",
          "feature": "contacts",
          "description": "Delete contact (if no history)"
        }
      ]
    },
    "transactions": {
      "name": "Transactions",
      "description": "Sales, purchases, expenses — inventory-linked and quick-sale modes",
      "businessTypes": ["product", "service", "both"],
      "features": ["transactions"],
      "endpoints": [
        {
          "method": "POST",
          "path": "/transactions/sell",
          "feature": "transactions",
          "description": "Record inventory sale (decrements stock)"
        },
        {
          "method": "POST",
          "path": "/transactions/quick-sell",
          "feature": "quick_sale",
          "description": "Fast sale — no product required"
        },
        {
          "method": "POST",
          "path": "/transactions/buy",
          "feature": "transactions",
          "description": "Record purchase (increments stock)"
        },
        {
          "method": "POST",
          "path": "/transactions/expense",
          "feature": "transactions",
          "description": "Record expense with category"
        },
        {
          "method": "GET",
          "path": "/transactions",
          "feature": "transactions",
          "description": "List transactions (filter by type, contact, date)"
        },
        {
          "method": "GET",
          "path": "/transactions/:id",
          "feature": "transactions",
          "description": "Get single transaction with line items"
        }
      ],
      "notes": "salesChannel and discount fields available on sell/quick-sell. expenseStatus and receiptLink on expenses."
    },
    "inventory": {
      "name": "Inventory",
      "description": "Products, categories, stock levels, low-stock alerts",
      "businessTypes": ["product", "both"],
      "features": ["inventory"],
      "endpoints": [
        {
          "method": "POST",
          "path": "/inventory/categories",
          "feature": "inventory",
          "description": "Create category"
        },
        {
          "method": "GET",
          "path": "/inventory/categories",
          "feature": "inventory",
          "description": "List categories"
        },
        {
          "method": "PATCH",
          "path": "/inventory/categories/:id",
          "feature": "inventory",
          "description": "Update category"
        },
        {
          "method": "DELETE",
          "path": "/inventory/categories/:id",
          "feature": "inventory",
          "description": "Delete category (if empty)"
        },
        {
          "method": "POST",
          "path": "/inventory/products",
          "feature": "inventory",
          "description": "Create product (supports trackStock, status, deliveryTimeline)"
        },
        {
          "method": "GET",
          "path": "/inventory/products",
          "feature": "inventory",
          "description": "List products (filter by categoryId, search)"
        },
        {
          "method": "GET",
          "path": "/inventory/products/:id",
          "feature": "inventory",
          "description": "Get product with isLowStock flag"
        },
        {
          "method": "PATCH",
          "path": "/inventory/products/:id",
          "feature": "inventory",
          "description": "Update product"
        },
        {
          "method": "DELETE",
          "path": "/inventory/products/:id",
          "feature": "inventory",
          "description": "Delete product"
        },
        {
          "method": "PATCH",
          "path": "/inventory/products/:id/adjust-stock",
          "feature": "stock_tracking",
          "description": "Manual stock adjustment (damage, theft, correction)"
        }
      ]
    },
    "debts": {
      "name": "Debts",
      "description": "Receivables (money owed to you) and payables (money you owe)",
      "businessTypes": ["product", "service", "both"],
      "features": ["debts"],
      "endpoints": [
        {
          "method": "GET",
          "path": "/debts",
          "feature": "debts",
          "description": "List debts (filter by type, status, contactId)"
